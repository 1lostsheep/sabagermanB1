# Copy to .env (setup.sh does this). Never commit .env.
LEARNER_NAME=Saba
# 4-digit PIN for Paz's page
PAZ_PIN=1234
# Phase 2: speaking practice, letter marking, monthly check
ANTHROPIC_API_KEY=
MONTHLY_BUDGET_EUR=25
PORT=8765

# Lesson audio voices (used only when building content, never by the app):
#   google = natural modern voices (needs GOOGLE_TTS_API_KEY; only lesson text is sent)
#   piper  = free, offline, more robotic
TTS_ENGINE=piper
GOOGLE_TTS_API_KEY=
# Leave empty to pick the most natural German voices automatically,
# or set names chosen with: .venv/bin/python tools/voice_samples.py
GOOGLE_TTS_VOICE_F=
GOOGLE_TTS_VOICE_M=
# 1.0 = normal speed; a bit slower is easier for a learner
GOOGLE_TTS_RATE=0.92
